#!/bin/sh
# rm-trash: what the interactive `rm` abbr runs. Moves files to the trash instead of deleting them.
#   Linux: trash-cli (freedesktop trash, ~/.local/share/Trash; same trash as the file manager)
#          restore: trash-restore, list: trash-list
#   macOS: /usr/bin/trash (Finder trash; restore with Finder's "Put Back")
#   Lab servers' data disks (/data*): trash-cli would make <disk>/.Trash-<uid> at the top of the disk, but only
#          users/, projects/ and docker/ may sit there (snuhcs/server docs/disk.md). So a file on a /data* disk goes
#          to <disk>/users/<me>/.trash instead (same disk, nothing copied), emptied by the same daily timer.
#          trash-restore does not look there: list with `trash-list --trash-dir <that dir>`, restore by moving
#          files/<name> back to the Path in info/<name>.trashinfo (then delete that .trashinfo).
# rm's options (-r -f -i -v -d -I, combined like -rf) are accepted and ignored, so `rm -rf dir` works.
# Real deletion: `rm-fr` (plain /bin/rm). Under sudo the files go to root's trash (on /data*: the sudo user's).
set -e
files=""
endopts=0
for a in "$@"; do
  if [ "$endopts" = 0 ]; then
    case "$a" in
      --) endopts=1; continue ;;
      --recursive|--force|--interactive*|--verbose|--dir|-[rRfivdI]*) continue ;;
      -*) echo "rm-trash: unknown option $a (use rm-fr for real rm)" >&2; exit 2 ;;
    esac
  fi
  [ -e "$a" ] || [ -L "$a" ] || { echo "rm-trash: $a: no such file" >&2; status=1; continue; }
  files="$files
$a"
done
[ -n "$files" ] || exit "${status:-0}"
case "$(uname)" in
  Darwin) cmd=/usr/bin/trash ;;
  *)
    cmd=$(command -v trash-put || true)
    # sudo's PATH does not include the user's Nix profile
    [ -n "$cmd" ] || { [ -n "$SUDO_USER" ] && cmd=$(eval echo "~$SUDO_USER")/.nix-profile/bin/trash-put; }
    [ -x "$cmd" ] || { echo "rm-trash: trash-put not found (install trash-cli)" >&2; exit 1; } ;;
esac
me=${SUDO_USER:-$(id -un)}
# <disk>/users/<me>/.trash when the file sits on a /data* disk (Linux), else nothing (the tool's own trash)
data_trash() {
  [ "$(uname)" = Linux ] || return 0
  top=$(df --output=target -- "$1" 2>/dev/null | tail -1)
  case "$top" in /data*) ;; *) return 0 ;; esac
  [ -d "$top/users" ] || return 0
  mkdir -p "$top/users/$me/.trash" && printf '%s\n' "$top/users/$me/.trash"
}
# macOS trash returns 0 even when it did nothing, so check that each file is gone afterwards
printf '%s\n' "$files" | sed '1d' | {
  rc=0
  while IFS= read -r f; do
    case "$f" in -*) f="./$f" ;; esac   # neither tool takes "--"
    td=$(data_trash "$f") || td=""
    if [ -n "$td" ]; then "$cmd" --trash-dir "$td" "$f" || true; else "$cmd" "$f" || true; fi
    if [ -e "$f" ] || [ -L "$f" ]; then echo "rm-trash: could not trash $f" >&2; rc=1; fi
  done
  exit $rc
} || status=1
exit "${status:-0}"
