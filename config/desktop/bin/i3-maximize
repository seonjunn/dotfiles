#!/usr/bin/env python3
"""Toggle a 'fullscreen' that leaves the top bar visible: the focused tiled window
is made floating and sized to the workspace area (which excludes the bar).
Toggling again re-tiles it. Floating windows fall back to real fullscreen."""
import json, subprocess

def i3(cmd):
    return subprocess.run(["i3-msg", cmd], capture_output=True, text=True).stdout

tree = json.loads(i3("-t get_tree") if False else subprocess.run(["i3-msg", "-t", "get_tree"], capture_output=True, text=True).stdout)

def find(n, ws=None, floating=False):
    if n.get("type") == "workspace":
        ws = n
    if n.get("type") == "floating_con":
        floating = True
    if n.get("focused") and n.get("window"):
        return n, ws, floating
    for c in n.get("nodes", []) + n.get("floating_nodes", []):
        r = find(c, ws, floating)
        if r:
            return r

found = find(tree)
if not found:
    raise SystemExit
con, ws, floating = found

if "_max" in con.get("marks", []):
    i3(f'[con_id={con["id"]}] floating disable, unmark _max, border pixel 2')
elif floating or con.get("fullscreen_mode"):
    i3("fullscreen toggle")
else:
    r = ws["rect"]
    i3(f'[con_id={con["id"]}] mark _max, floating enable, border none, '
       f'resize set {r["width"]} {r["height"]}, move position {r["x"]} {r["y"]}')
