#!/usr/bin/env bash
# Run Codex with a ccsx auth profile and resume across all shared sessions.
#
# Codex's own picker (`codex resume`, `--last`) lists only threads created by the
# current account, even when the profiles share one sessions directory. A session
# id still resumes across accounts, so this lists every rollout in the shared
# directory and hands the chosen id to `ccsx resume`.
#
# Usage: cxs [auth-profile] [--resume|resume] [options...]
#   auth-profile  an existing ccsx auth profile; otherwise ccsx selects the default
#   --resume      pick from every account's shared sessions
#   resume ID     resume a session directly
#   -n N, -l      resume picker: list N recent sessions, or print the list
#   Other options and prompts go to Codex unchanged; execution defaults to --yolo.
#
# Each profile's sessions/ must link to the shared directory; this script only reads.
set -euo pipefail

usage() {
	printf '%s\n' \
		'Usage: cxs [AUTH] [--resume|resume] [options...]' \
		'' \
		'  cxs                 start with the default ccsx auth' \
		'  cxs AUTH            start with an existing ccsx auth profile' \
		'  cxs AUTH --resume   pick from all accounts in the shared sessions' \
		'' \
		'New runs and resumes default to --yolo.' \
		'Resume picker options: -n N (default 200), -l (print the list).' \
		'Use cxs [AUTH] resume ID to resume directly. Other options go to Codex.'
}

profile=''
if [ $# -gt 0 ] && [ -d "$HOME/.ccs/codex-instances/$1" ]; then
	profile="$1"
	shift
fi

resume=0
codex_args=()
for arg in "$@"; do
	case "$arg" in
	--resume) resume=1 ;;
	*) codex_args+=("$arg") ;;
	esac
done
if [ "${codex_args[0]:-}" = resume ]; then
	resume=1
	codex_args=("${codex_args[@]:1}")
fi
yolo_args=(--yolo)
for arg in "${codex_args[@]}"; do
	case "$arg" in
	-h | --help) usage; exit 0 ;;
	--yolo | --dangerously-bypass-approvals-and-sandbox) yolo_args=() ;;
	esac
done

run_codex() {
	if [ -n "$profile" ]; then
		exec env CCS_CODEX_PROFILE="$profile" ccsx "$@"
	else
		exec ccsx "$@"
	fi
}

if [ "$resume" = 0 ]; then run_codex "${yolo_args[@]}" "${codex_args[@]}"; fi

limit=200
list_only=0
set -- "${codex_args[@]}"
codex_args=()
while [ $# -gt 0 ]; do
	case "$1" in
	-n)
		if [ $# -lt 2 ] || [[ ! "$2" =~ ^[1-9][0-9]*$ ]]; then
			echo 'cxs: -n requires a positive session count' >&2
			exit 2
		fi
		limit="$2"; shift 2 ;;
	-l) list_only=1; shift ;;
	*) codex_args+=("$1"); shift ;;
	esac
done
# A direct id or Codex's own --last/--all selection needs no shared picker.
for arg in "${codex_args[@]}"; do
	case "$arg" in
	--last | --all | [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-*)
		if [ "$list_only" = 0 ]; then run_codex resume "${yolo_args[@]}" "${codex_args[@]}"; fi ;;
	esac
done

SESSIONS="${CODEX_SHARED_SESSIONS:-$HOME/.codex/sessions}"
PROFILES="$HOME/.ccs/codex-profiles.yaml"

# account_id -> profile name, for the "made by" column.
declare -A owner=()
if [ -r "$PROFILES" ] && command -v yq >/dev/null; then
	while IFS=$'\t' read -r acct name; do
		[ -n "$acct" ] && owner[$acct]=$name
	done < <(yq -r '.profiles | to_entries[] | [.value.account_id, .key] | @tsv' "$PROFILES" 2>/dev/null || true)
fi

if [ "$(uname)" = Darwin ]; then stat_mtime=(stat -f '%m%t%N'); else stat_mtime=(stat --printf '%Y\t%n\n'); fi

# Thread titles Codex generated ("thread_name"). Each CODEX_HOME keeps its own index, so read
# the shared home and every profile; the latest entry for an id wins.
titles=$({ cat "$HOME/.codex/session_index.jsonl" "$HOME"/.ccs/codex-instances/*/session_index.jsonl 2>/dev/null || true; } |
	jq -cs 'map(select(.id and .thread_name)) | sort_by(.updated_at) | map({(.id): .thread_name}) | add // {}' 2>/dev/null ||
	echo '{}')

# Laid out like `codex resume`: newest first, age, then the title (or the first prompt when
# Codex has not named the thread), with owner profile and cwd dimmed after it.
dim=$'\e[2m' off=$'\e[0m'
[ "$list_only" = 1 ] && dim='' off=''

list_sessions() {
	# Newest first by modification time (last activity), not by creation.
	find -L "$SESSIONS" -type f -name 'rollout-*.jsonl' -exec "${stat_mtime[@]}" {} + 2>/dev/null |
		sort -rn | head -n "$limit" |
		while IFS=$'\t' read -r epoch f; do
			# The first user prompt sits in the first few hundred lines; never read whole rollouts.
			head -n 300 "$f" | jq -rs --argjson epoch "$epoch" --argjson titles "$titles" '
				(now - $epoch) as $d
				| (if $d < 60 then "now"
					elif $d < 3600 then "\($d / 60 | floor)m ago"
					elif $d < 86400 then "\($d / 3600 | floor)h ago"
					else "\($d / 86400 | floor)d ago" end) as $age
				| (map(select(.type == "session_meta")) | first | .payload) as $m
				| (map(select(.type == "response_item" and .payload.type == "message" and .payload.role == "user")
					| .payload.content[]?.text // empty
					| select(startswith("<") or startswith("# AGENTS.md") | not))
					| first // "") as $msg
				| select($m.id != null and $m.thread_source != "subagent")
				| [$m.id, $age, ($m.creator_account_id // "-"), ($m.cwd // "-"),
					($titles[$m.id] // $msg | gsub("[\\t\\n\\r]+"; " ") | .[:80])] | @tsv' 2>/dev/null || true
		done |
		while IFS=$'\t' read -r id age acct cwd title; do
			who="${owner[$acct]:-${acct:0:8}}"
			printf '%s\t%-10s %s  %s%s · %s%s\n' "$id" "$age" "$title" "$dim" "$who" "${cwd/#$HOME/\~}" "$off"
		done
}

if [ "$list_only" = 1 ]; then
	list_sessions | cut -f2-
	exit 0
fi

command -v fzf >/dev/null || { echo "cxs: fzf not found; use resume -l and run: cxs resume <id>" >&2; exit 2; }

# fzf closes the pipe once a line is picked, so the lister dies of SIGPIPE and pipefail
# fails the pipeline; judge by the selection instead of the exit status.
line=$(list_sessions | fzf --ansi --delimiter='\t' --with-nth=2 --no-sort \
	--layout=reverse --info=inline-right --pointer='›' --gutter=' ' --prompt='Type to search › ' \
	--header="Resume a previous session  (as ${profile:-${CCS_CODEX_PROFILE:-default}}, all accounts)" --header-first \
	--footer='enter resume   esc quit   ↑/↓ browse') || true
[ -n "$line" ] || exit 0
id="${line%%$'\t'*}"

run_codex resume "${yolo_args[@]}" "$id" "${codex_args[@]}"
