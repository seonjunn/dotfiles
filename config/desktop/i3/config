# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
set $wsA "AI"
set $wsC "Calendar"
set $wsS "Slack"
set $wsM "Mail"
set $wsN "Note"
set $wsO "Obsidian"
set $wsD "Discord"
set $wsW "Work"
set $wsP "Spotify"
set $wsZ "Zotero"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+a workspace $wsA
bindsym $mod+c workspace $wsC
bindsym $mod+s workspace $wsS
bindsym $mod+m workspace $wsM
bindsym $mod+n workspace $wsN
bindsym $mod+o workspace $wsO
bindsym $mod+d workspace $wsD
bindsym $mod+p workspace $wsP
bindsym $mod+w workspace $wsW
bindsym $mod+z workspace $wsZ

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10
bindsym $mod+Shift+a move container to workspace $wsA
bindsym $mod+Shift+c move container to workspace $wsC
bindsym $mod+Shift+s move container to workspace $wsS
bindsym $mod+Shift+m move container to workspace $wsM
bindsym $mod+Shift+n move container to workspace $wsN
bindsym $mod+Shift+o move container to workspace $wsO
bindsym $mod+Shift+d move container to workspace $wsD
bindsym $mod+Shift+p move container to workspace $wsP
bindsym $mod+Shift+w move container to workspace $wsW
bindsym $mod+Shift+z move container to workspace $wsZ

bindsym $mod+Tab workspace back_and_forth

# assigning workspaces
workspace $ws1	output $monL 
workspace $ws3  output $monL
workspace $ws5  output $monL
workspace $ws7  output $monL
workspace $ws9  output $monL

workspace $ws2  output $monR
workspace $ws4  output $monR
workspace $ws6  output $monR
workspace $ws8  output $monR
workspace $ws10	output $monR

workspace $wsA  output $monL
workspace $wsS  output $monL
workspace $wsD	output $monL
workspace $wsW	output $monL

workspace $wsC	output $monR
workspace $wsM  output $monR
workspace $wsN  output $monR
workspace $wsP	output $monR
workspace $wsZ	output $monR
workspace $wsO	output $monR

# reload the configuration file
bindsym $mod+Shift+r reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
#bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Set shut down, restart and locking features
bindsym $mod+Escape mode "$mode_system"
set $mode_system (l)ock, (e)xit, switch_(u)ser, (s)uspend, (h)ibernate, (r)eboot, (Shift+s)hutdown
mode "$mode_system" {
    bindsym l exec --no-startup-id ~/.config/i3/lock-with-xmodmap, mode "default"
    bindsym s exec --no-startup-id i3exit suspend, mode "default"
    bindsym u exec --no-startup-id i3exit switch_user, mode "default"
    bindsym e exec --no-startup-id i3exit logout, mode "default"
    bindsym h exec --no-startup-id i3exit hibernate, mode "default"
    bindsym r exec --no-startup-id i3exit reboot, mode "default"
    bindsym Shift+s exec --no-startup-id i3exit shutdown, mode "default"

    # exit system mode: "Enter" or "Escape"
    bindsym Return $exit_modifier
    bindsym Escape $exit_modifier
}

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return $exit_modifier
        bindsym Escape $exit_modifier
        bindsym $mod+r $exit_modifier
}

bindsym $mod+r mode "resize"

# modifier mode trigger
set $exit_modifier mode "default"; gaps inner all set 10; [all] border pixel 2
bindsym Control+space mode "modifier"; gaps inner all set 60; [all] border pixel 2

mode "modifier" {
    # change focus
    bindsym h focus left
    bindsym j focus down
    bindsym k focus up
    bindsym l focus right

    bindsym Left focus left
    bindsym Down focus down
    bindsym Up focus up
    bindsym Right focus right

    # move focused window
    bindsym Shift+h move left
    bindsym Shift+j move down
    bindsym Shift+k move up
    bindsym Shift+l move right

    bindsym Shift+Left move left
    bindsym Shift+Down move down
    bindsym Shift+Up move up
    bindsym Shift+Right move right

    # switch to workspace
    bindsym 1 workspace number $ws1
    bindsym 2 workspace number $ws2
    bindsym 3 workspace number $ws3
    bindsym 4 workspace number $ws4
    bindsym 5 workspace number $ws5
    bindsym 6 workspace number $ws6
    bindsym 7 workspace number $ws7
    bindsym 8 workspace number $ws8
    bindsym 9 workspace number $ws9
    bindsym 0 workspace number $ws10
    bindsym a workspace $wsA
    bindsym c workspace $wsC
    bindsym s workspace $wsS
    bindsym m workspace $wsM
    bindsym n workspace $wsN
    bindsym o workspace $wsO
    bindsym d workspace $wsD
    bindsym p workspace $wsP
    bindsym w workspace $wsW
    bindsym z workspace $wsZ

    # move focused container to workspace
    bindsym Shift+1 move container to workspace number $ws1
    bindsym Shift+2 move container to workspace number $ws2
    bindsym Shift+3 move container to workspace number $ws3
    bindsym Shift+4 move container to workspace number $ws4
    bindsym Shift+5 move container to workspace number $ws5
    bindsym Shift+6 move container to workspace number $ws6
    bindsym Shift+7 move container to workspace number $ws7
    bindsym Shift+8 move container to workspace number $ws8
    bindsym Shift+9 move container to workspace number $ws9
    bindsym Shift+0 move container to workspace number $ws10
    bindsym Shift+a move container to workspace $wsA
    bindsym Shift+c move container to workspace $wsC
    bindsym Shift+s move container to workspace $wsS
    bindsym Shift+m move container to workspace $wsM
    bindsym Shift+n move container to workspace $wsN
    bindsym Shift+o move container to workspace $wsO
    bindsym Shift+d move container to workspace $wsD
    bindsym Shift+p move container to workspace $wsP
    bindsym Shift+w move container to workspace $wsW
    bindsym Shift+z move container to workspace $wsZ

    # back to normal: Enter or Escape or Control+space
    bindsym Return exec kitty; $exit_modifier
    bindsym Escape mode "$mode_system"
    bindsym Control+space $exit_modifier

    # kill focused window
    bindsym q kill

    # split in horizontal orientation
    bindsym Shift+v split h

    # split in vertical orientation
    bindsym v split v

    # enter fullscreen mode for the focused container
    bindsym f fullscreen toggle

    # change container layout (stacked, tabbed, toggle split)
    bindsym e layout toggle split

    # toggle tiling / floating
    bindsym Shift+space floating toggle

    # reload the configuration file
    bindsym Shift+r reload; $exit_modifier

    # exit i3 (logs you out of your X session)
    bindsym Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"; $exit_modifier

    # System mode
    # bindsym semicolon mode "$mode_system"

    # resize mode
    bindsym r mode "resize"

    # back and forth
    bindsym Tab workspace back_and_forth
}

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
# bar {
#         status_command i3status
